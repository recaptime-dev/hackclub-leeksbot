{
  "name": "@recaptime-dev/hackclub-leeksbot",
  "version": "0.2.0",
  "description": "The backend code for Hack Club Leeks app.",
  "main": "app.ts",
  "workspaces": [
    "tools"
  ],
  "scripts": {
    "start": "dotenvx run -f .env.production -- tsx app.ts",
    "dev": "dotenvx run -f .env.development -- tsx watch --clear-screen=false app.ts",
    "studio": "npm run studio:dev",
    "generate:dev": "dotenvx run -f .env.development -- prisma generate --no-engine",
    "generate:prod": "dotenvx run -f .env.production -- prisma generate --no-engine",
    "migrate:dev": "dotenvx run -f .env.development -- prisma migrate dev",
    "migrate:prod": "dotenvx run -f .env.production -- prisma migrate deploy",
    "studio:dev": "BROWSER=none dotenvx run -f .env.development-- prisma studio --browser none",
    "studio:prod": "BROWSER=none dotenvx run -f .env.production -- prisma studio -- browser none",
    "manifests:dev": "cd tools && npm run manifests:dev",
    "manifests:prod": "cd tools && npm run manifests:prod",
    "dotenvx:prod": "dotenvx run -f .env.production --",
    "dotenvx:dev": "dotenvx run -f .env.development --",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "update-deps": "ncu -u && npm install && npm run generate:dev"
  },
  "author": {
    "name": "Andrei Jiroh Halili",
    "email": "ajhalili2006@andreijiroh.dev",
    "url": "https://andreijiroh.dev"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/recaptime-dev/hackclub-leeksbot"
  },
  "bugs": {
    "url": "https://mau.dev/andreijiroh-dev/leeksbot/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/ajhalili2006"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.41.0",
    "@prisma/client": "^6.7.0",
    "@prisma/extension-accelerate": "^1.3.0",
    "@sentry/node": "^9.15.0",
    "@sentry/profiling-node": "^9.15.0",
    "@slack/bolt": "^4.2.1",
    "@slack/logger": "^4.0.0",
    "@slack/web-api": "^7.9.1",
    "markdown-it-footnote": "^4.0.0",
    "tsx": "^4.19.4",
    "vitepress": "^1.6.3",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "npm-check-updates": "^18.0.1",
    "prisma": "^6.7.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
