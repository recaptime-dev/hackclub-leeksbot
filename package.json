{
  "name": "@recaptime-dev/hackclub-leeksbot",
  "version": "0.2.0",
  "description": "The backend code for Hack Club Leeks app.",
  "type": "module",
  "main": "app.ts",
  "workspaces": [
    "tools"
  ],
  "scripts": {
    "start": "dotenvx run -f .env.production -- tsx app.ts",
    "dev": "dotenvx run -f .env.development -- tsx watch --clear-screen=false app.ts",
    "studio": "npm run studio:dev",
    "generate": "npm run prisma:generate",
    "prisma:studio": "npm run studio:dev",
    "prisma:generate": "dotenvx run -f .env.development -- prisma generate",
    "migrate:dev": "dotenvx run -f .env.development -- prisma migrate dev",
    "migrate:prod": "dotenvx run -f .env.production -- prisma migrate deploy",
    "studio:dev": "BROWSER=none dotenvx run -f .env.development -- prisma studio",
    "studio:prod": "BROWSER=none dotenvx run -f .env.production -- prisma studio",
    "manifests:dev": "cd tools && npm run manifests:dev",
    "manifests:prod": "cd tools && npm run manifests:prod",
    "dotenvx:prod": "dotenvx run -f .env.production --",
    "dotenvx:dev": "dotenvx run -f .env.development --",
    "dotenvx:inject-op": "op inject -i .env.keys.tmpl -o .env.keys",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "update-deps": "ncu -u && npm install && npm run generate:dev"
  },
  "author": {
    "name": "Andrei Jiroh Halili",
    "email": "ajhalili2006@andreijiroh.dev",
    "url": "https://andreijiroh.dev"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/recaptime-dev/hackclub-leeksbot"
  },
  "bugs": {
    "url": "https://mau.dev/andreijiroh-dev/leeksbot/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/ajhalili2006"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@prisma/instrumentation": "^7.2.0",
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "@slack/bolt": "^4.6.0",
    "@slack/logger": "^4.0.0",
    "@slack/web-api": "^7.13.0",
    "dotenv": "^17.2.3",
    "markdown-it-footnote": "^4.0.0",
    "pg": "^8.16.3",
    "tsx": "^4.21.0",
    "vitepress": "^1.6.4",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@prisma/ppg-tunnel": "^0.4.0",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "npm-check-updates": "^19.2.0",
    "prisma": "^7.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
