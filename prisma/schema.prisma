generator client {
  provider      = "prisma-client"
  output        = "./client"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  binaryTargets = ["native", "linux-musl"]
  moduleFormat  = "cjs"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model SlackLeeks {
  message_id            String   @id @unique
  first_flagged_by      String
  status                String   @default("pending")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  leeks_channel_post_id String?
  channel_id            String
  review_queue_id       String?
  permalink_message_id  String?
  is_major_leek         Boolean  @default(false)
  leeks_flags           Int      @default(0)
  leeks_reacts          Int      @default(0)
  rejection_reason      String?
}

model SlackChannels {
  id             String   @id @unique
  allowlisted    Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  allowlisted_by String   @default("system")
}

model SlackUsers {
  id          String    @id @unique
  bot_admin   Boolean   @default(false)
  is_banned   Boolean   @default(false)
  ban_reason  String?
  banned_by   String?
  banned_at   DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  promoted_by String?
}
