#!/usr/bin/env bash

# SPDX-License-Identifier: MIT

# Check if a refresh token is provided
if [ -z "$1" ]; then
  echo "Usage: $0 <refresh_token>"
  exit 1
fi

REFRESH_TOKEN="$1"
SLACK_API_URL="https://slack.com/api/tooling.tokens.refresh"

# Make the API call to refresh the token
response=$(curl -s -X POST "$SLACK_API_URL" \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "refresh_token=${REFRESH_TOKEN}")

# Check if the API call was successful
if echo "$response" | grep -q '"ok":true'; then
  echo "Token refreshed successfully:"
  token=$(echo "$response" | jq -r '.token')
  refresh_token=$(echo "$response" | jq -r '.refresh_token')
  echo "Token: $token"
  echo "Refresh Token: $refresh_token"
else
  error_code=$(echo "$response" | jq -r '.error')
  echo "Failed to refresh token. Error: $error_code"
fi

